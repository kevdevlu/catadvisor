APP_NAME="CatAdvisor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://catadvisor.ddev.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DDEV's local Postgres (ddev start fills these in). Laravel Cloud sets its own.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# CatAdvisor
# The dataset is written as of this date, so all date math uses it.
APP_TODAY=2026-10-05
# One shared password for every demo account. Never commit a real value.
DEMO_PASSWORD=
ANTHROPIC_API_KEY=

# On Laravel Cloud (production), also set:
#   APP_ENV=production
#   APP_DEBUG=false            (no stack traces in error responses)
#   APP_URL=https://<the app's address>
#   SESSION_SECURE_COOKIE=true (cookies only travel over HTTPS)
#   SESSION_LIFETIME=20160     (14 days; without it, 120 minutes)
#   DEMO_PASSWORD=<a 3-word passphrase>
#   ANTHROPIC_API_KEY=<the key>
